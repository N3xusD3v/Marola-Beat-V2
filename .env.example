# Copie este arquivo para `.env` e preencha os valores antes de rodar o bot.

# Token do bot, obtido no Discord Developer Portal (Bot > Token).
DISCORD_TOKEN=

# ID da aplicação (Application ID / Client ID), na aba General Information.
DISCORD_APP_ID=

# Client Secret da aplicação (OAuth2 > General), usado pelo login do painel web.
DISCORD_CLIENT_SECRET=

# ID do servidor (guild) usado para registrar comandos rapidamente em desenvolvimento.
# Deixe em branco em produção para registrar os comandos globalmente (propagação em até 1h).
GUILD_ID=

# ID do servidor (guild) cuja fila o painel web gerencia. Obrigatório.
WEB_GUILD_ID=

# URL pública onde o painel web fica acessível, sem barra no final
# (ex: https://beat.n3xus.dev). Usada para montar o redirect_uri do OAuth2.
PUBLIC_URL=

# String aleatória usada para assinar o cookie de sessão do painel web.
# Gere uma com: openssl rand -hex 32
SESSION_SECRET=

# Porta interna em que o painel web escuta. Padrão: 3000.
PORT=3000

# Nível de log: debug | info | warn | error. Padrão: info.
LOG_LEVEL=info
