# Copie este arquivo para `.env` e preencha os valores antes de rodar o bot.

# Token do bot, obtido no Discord Developer Portal (Bot > Token).
DISCORD_TOKEN=

# ID da aplicação (Application ID / Client ID), na aba General Information.
DISCORD_APP_ID=

# ID do servidor (guild) usado para registrar comandos rapidamente em desenvolvimento.
# Deixe em branco em produção para registrar os comandos globalmente (propagação em até 1h).
GUILD_ID=

# Nível de log: debug | info | warn | error. Padrão: info.
LOG_LEVEL=info
